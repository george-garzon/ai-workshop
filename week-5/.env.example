# Purpose: show the configuration names expected by core/settings.py.
# Your task: implement the matching Settings fields, then copy this template to
# week-5/.env and replace placeholders locally when you need live model calls.
# This file is safe to share only while it contains example values, not real keys.

# Credential used only by the model-provider service. Never log its value.
OPENAI_API_KEY=sk-your-key-here
# Model identifier passed by your model service; verify access when going live.
OPENAI_MODEL=gpt-5-mini

# Bound output size for an individual model response. Must be a positive integer.
MAX_OUTPUT_TOKENS=1000
# Bound decision attempts per run, including failed attempts. Positive integer.
MAX_AGENT_ITERATIONS=5

# General application configuration. DEBUG does not turn provider calls into mocks.
ENVIRONMENT=development
DEBUG=true

# Check: settings should convert numeric/boolean strings to the correct types.
# Reading the file alone has no effect until you implement the settings loader.
